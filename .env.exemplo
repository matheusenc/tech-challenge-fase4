# Copie este arquivo para ".env" e preencha com os dados do portal do Azure.
# O arquivo .env NÃO deve ir para o Git (já está no .gitignore).

# Recurso "Speech" (Azure AI Speech) -> Chaves e Ponto de extremidade
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Recurso "Language" (Azure AI Language / Text Analytics) -> Chaves e Ponto de extremidade
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com/

# Opcional: canal real da equipe (Discord, Slack...). Se preenchido, substitui a URL fixa
# de demonstração (webhook.site) definida em monitoramento/config.py.
WEBHOOK_EQUIPE_MEDICA=
